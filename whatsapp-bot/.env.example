# אותו מסד Redis (Upstash) שהבוט של טלגרם משתמש בו — כדי ששני הערוצים
# יראו את אותם מוצרים והזמנות
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# הבוט של טלגרם — נדרש כדי להוריד את תמונות המוצרים ששמורות שם
TELEGRAM_ADMIN_BOT_TOKEN=

# בוט/חשבון טלגרם נפרד שמקבל התראות על הזמנות חדשות (אותו אחד כמו בבוט הטלגרם)
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=

# הטקסט שיוצג ללקוחות שבוחרים לשלם בביט
MERAV_BIT_INFO=

# תיקייה לשמירת חיבור הוואטסאפ (session) — צריך להיות דיסק קבוע (volume),
# אחרת אחרי כל הפעלה מחדש יהיה צריך לסרוק QR מחדש
AUTH_DIR=./auth_data

PORT=3000
