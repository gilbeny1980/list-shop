# ============================================
# בוט הזמנות בוואטסאפ + ניהול בטלגרם
# ============================================

# WhatsApp Cloud API (Meta) — Meta for Developers > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# מחרוזת חופשית שאת בוחרת בעצמך, ומזינה גם באותו ערך כשמגדירים את ה-Webhook ב-Meta
WHATSAPP_VERIFY_TOKEN=

# בוט טלגרם לניהול מוצרים (מירב מוסיפה כאן מוצרים ומחירים באמצעות /addproduct)
# צרי בוט חדש דרך @BotFather בטלגרם וקבלי ממנו את הטוקן
TELEGRAM_ADMIN_BOT_TOKEN=
# מזהי הצ'אט המורשים לנהל מוצרים (אפשר כמה, מופרדים בפסיק). אפשר לקבל מזהה מ-@userinfobot
TELEGRAM_ADMIN_CHAT_IDS=

# בוט/חשבון טלגרם נפרד, שמקבל רק התראות על הזמנות חדשות
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=

# הטקסט שיוצג ללקוחות כשהם בוחרים לשלם בביט (מספר טלפון / קישור)
MERAV_BIT_INFO=

# Upstash Redis — משותף עם שאר האפליקציה (אחסון מוצרים/הזמנות/שיחות פעילות)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
