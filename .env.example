# ============================================
# בוט הזמנות (טלגרם + וואטסאפ אופציונלי) + ניהול מוצרים בטלגרם
# ============================================

# הבוט הראשי בטלגרם (למשל @merav_admin_bot) משמש לשני תפקידים:
#  - מי שנמצא ב-TELEGRAM_ADMIN_CHAT_IDS: מנהל מוצרים (/addproduct וכו')
#  - כל אחד/ת אחר/ת ששולח/ת הודעה: מקבל/ת את תפריט ההזמנות
# Webhook: <כתובת האתר>/api/shop-bot/telegram
TELEGRAM_ADMIN_BOT_TOKEN=
# מזהי הצ'אט המורשים לנהל מוצרים (אפשר כמה, מופרדים בפסיק). מתקבל מ-@userinfobot
TELEGRAM_ADMIN_CHAT_IDS=

# WhatsApp Cloud API (Meta) — אופציונלי, רק אם רוצים גם ערוץ הזמנות בוואטסאפ
# Meta for Developers > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# מחרוזת חופשית שאת בוחרת בעצמך, ומזינה גם באותו ערך כשמגדירים את ה-Webhook ב-Meta
WHATSAPP_VERIFY_TOKEN=

# בוט/חשבון טלגרם נפרד, שמקבל רק התראות על הזמנות חדשות
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=

# הטקסט שיוצג ללקוחות כשהם בוחרים לשלם בביט (מספר טלפון / קישור)
MERAV_BIT_INFO=

# Upstash Redis — משותף עם שאר האפליקציה (אחסון מוצרים/הזמנות/שיחות פעילות)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
